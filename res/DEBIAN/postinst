#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/hsi-remote/hsi-remote /usr/bin/hsi-remote

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/hsi-remote.service ]; then
			rm -f /etc/systemd/system/hsi-remote.service /usr/lib/systemd/system/hsi-remote.service /usr/lib/systemd/user/hsi-remote.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/hsi-remote/files/systemd/hsi-remote.service /usr/lib/systemd/system/hsi-remote.service
		# try fix error in Ubuntu 18.04
		# Failed to reload hsi-remote.service: Unit hsi-remote.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/hsi-remote.service:10: Executable path is not absolute: pkill -f "hsi-remote --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/hsi-remote.service
		fi
		systemctl daemon-reload
		systemctl enable hsi-remote
		systemctl start hsi-remote
	fi
fi
